{
  "data_type": "structured_gap_fixture",
  "target_format": "structured/v1",
  "mapping_rules": [
    {"mapping_id":"source","source_schema":"fixture","target_schema":"structured/v1","source_path":"source","target_path":"source","transform":"identity","required":true},
    {"mapping_id":"object_key","source_schema":"fixture","target_schema":"structured/v1","source_path":"object_key","target_path":"object_key","transform":"identity","required":true},
    {"mapping_id":"entity_id","source_schema":"fixture","target_schema":"structured/v1","source_path":"entity_id","target_path":"entity_id","transform":"identity","required":false},
    {"mapping_id":"observed_at","source_schema":"fixture","target_schema":"structured/v1","source_path":"observed_at","target_path":"observed_at","transform":"identity","required":false},
    {"mapping_id":"ip","source_schema":"fixture","target_schema":"structured/v1","source_path":"ip","target_path":"ip","transform":"identity","required":false},
    {"mapping_id":"port","source_schema":"fixture","target_schema":"structured/v1","source_path":"port","target_path":"port","transform":"identity","required":false},
    {"mapping_id":"service_name","source_schema":"fixture","target_schema":"structured/v1","source_path":"service_name","target_path":"service_name","transform":"identity","required":false},
    {"mapping_id":"event_description","source_schema":"fixture","target_schema":"structured/v1","source_path":"event_description","target_path":"event_description","transform":"identity","required":false},
    {"mapping_id":"ai_label","source_schema":"fixture","target_schema":"structured/v1","source_path":"ai_label","target_path":"ai_label","transform":"identity","required":false}
  ],
  "cleaning": {
    "field_paths": ["ip", "port", "observed_at", "entity_id", "service_name"],
    "required_fields": ["source", "object_key"],
    "missing_policy": "record",
    "anomaly_rules": [
      {"rule_id":"ip_format","field_path":"ip","detector":"regex","pattern":"^([0-9]{1,3}\\.){3}[0-9]{1,3}$"},
      {"rule_id":"port_range","field_path":"port","detector":"range","minimum":1,"maximum":65535}
    ]
  },
  "quality_rules": [
    {"rule_id":"fixture_unique_object_key","dimension":"uniqueness","fields":["object_key"],"threshold":0.0},
    {"rule_id":"fixture_entity_present","dimension":"completeness","fields":["entity_id"],"threshold":100.0},
    {"rule_id":"fixture_timestamp_present","dimension":"completeness","fields":["observed_at"],"threshold":100.0},
    {"rule_id":"fixture_label_regex","dimension":"custom","custom_type":"regex","patterns":{"ai_label":"^(critical|warning|info)$"},"expression":"^(critical|warning|info)$"},
    {"rule_id":"fixture_sql_valid","dimension":"custom","custom_type":"sql","expression":"SELECT row_index FROM records WHERE json_extract(record_json, '$.object_key') IS NOT NULL"},
    {"rule_id":"fixture_python_valid","dimension":"custom","custom_type":"python","python_handler":"resource_identity_present"}
  ],
  "association": {
    "source_field": "source",
    "conditions": [
      {"field_path":"entity_id","condition_type":"entity_id","mode":"exact","required":false,"threshold":1.0},
      {"field_path":"ip","condition_type":"ip","mode":"exact","required":false,"threshold":1.0},
      {"field_path":"port","condition_type":"port","mode":"exact","required":false,"threshold":1.0},
      {"field_path":"observed_at","condition_type":"timestamp","mode":"exact","required":false,"tolerance_seconds":10,"threshold":1.0},
      {"field_path":"service_name","condition_type":"text","mode":"fuzzy","required":false,"threshold":0.7},
      {"field_path":"event_description","condition_type":"text","mode":"semantic","required":false,"threshold":0.3,"aliases":{"api":"service","ingress":"exposed"}}
    ],
    "min_sources": 2,
    "max_candidates": 50
  },
  "label_field": "ai_label"
}
