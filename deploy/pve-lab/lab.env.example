# Copy to /root/cnsec-lab/lab.env on the PVE host and adjust for the lab.

PVE_NODE=pve
PVE_STORAGE=local-lvm
PVE_LAB_BRIDGE=vmbr1
PVE_LAB_CIDR=10.20.0.0/24
PVE_LAB_GW=10.20.0.1

UBUNTU_TEMPLATE_ID=9000
UBUNTU_CLOUD_IMAGE=https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img
SSH_PUBKEY_PATH=/root/.ssh/agent_lab.pub
SSH_KEY_PATH=/root/.ssh/agent_lab

CP1_ID=111
CP1_NAME=k8s-cp-1
CP1_IP=10.20.0.11
W1_ID=102
W1_NAME=k8s-worker-1
W1_IP=10.20.0.12
W2_ID=103
W2_NAME=k8s-worker-2
W2_IP=10.20.0.13

K8S_MINOR=v1.36
K8S_VERSION=stable
POD_CIDR=192.168.0.0/16
SERVICE_CIDR=10.96.0.0/12

# Optional local mirror settings for restricted networks.
# K8S_IMAGE_REPOSITORY=registry.k8s.io

# Compatibility defaults used by the current PVE lab.
VM_CPU_TYPE=host
VM_NIC_MODEL=e1000
ROOT_DISK_SLOT=ide0
CLOUDINIT_SLOT=ide2
